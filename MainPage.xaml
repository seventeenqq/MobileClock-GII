<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Clock"
             x:Class="Clock.MainPage"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12"
                             MaximumWidthRequest="600"
                             HorizontalOptions="Fill"
                             VerticalOptions="Center">
            <Label Text="Местное время" TextColor="Black" FontSize="20"
                   HorizontalTextAlignment="Center" />
            <local:ClockView x:Name="LocalClock" HeightRequest="100" />

            <Label Text="Токио (UTC+9)" TextColor="Black" FontSize="20"
                   Margin="0,24,0,0" HorizontalTextAlignment="Center" />
            <local:ClockView x:Name="TokyoClock" HeightRequest="100" />

            <Label Text="Стокгольм (UTC+1)" TextColor="Black" FontSize="20"
                   Margin="0,24,0,0" HorizontalTextAlignment="Center" />
            <local:ClockView x:Name="StokClock" HeightRequest="100" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
